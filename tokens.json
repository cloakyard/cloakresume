{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Portable CloakResume product-chrome tokens. DESIGN.md defines use; tokens.css is the runtime source of truth.",
  "color": {
    "$type": "color",
    "paper": { "$value": "oklch(0.975 0.009 255)" },
    "paper-2": { "$value": "oklch(0.947 0.014 255)" },
    "surface": { "$value": "oklch(0.992 0.004 255)" },
    "surface-strong": { "$value": "oklch(0.925 0.019 255)" },
    "ink": { "$value": "oklch(0.225 0.031 255)" },
    "ink-2": { "$value": "oklch(0.43 0.035 255)" },
    "ink-3": { "$value": "oklch(0.48 0.03 255)" },
    "rule": { "$value": "oklch(0.865 0.022 255)" },
    "rule-strong": { "$value": "oklch(0.72 0.032 255)" },
    "accent": {
      "$value": "oklch(0.508 0.118 165.612)",
      "$description": "CloakResume Emerald 700 / #047857"
    },
    "accent-hover": { "$value": "oklch(0.432 0.095 166.913)" },
    "accent-active": { "$value": "oklch(0.378 0.077 168.94)" },
    "accent-soft": { "$value": "oklch(0.95 0.052 163.051)" },
    "accent-ink": { "$value": "oklch(0.985 0.004 255)" },
    "accent-label": { "$value": "{color.accent}" },
    "accent-night": { "$value": "oklch(0.765 0.151 163.223)" },
    "focus": { "$value": "oklch(0.596 0.145 163.225)" },
    "night": { "$value": "oklch(0.185 0.027 255)" },
    "night-2": { "$value": "oklch(0.235 0.03 255)" },
    "night-ink": { "$value": "oklch(0.96 0.012 255)" },
    "night-muted": { "$value": "oklch(0.735 0.024 255)" },
    "night-rule": { "$value": "oklch(0.34 0.034 255)" },
    "overlay": {
      "$value": "oklch(0.185 0.027 255 / 0.58)",
      "$description": "Resolved equivalent of the runtime Night 58% overlay"
    },
    "status-danger": { "$value": "oklch(0.505 0.213 27.518)" },
    "status-danger-soft": { "$value": "oklch(0.965 0.025 25)" },
    "status-warning": { "$value": "oklch(0.473 0.137 46.201)" },
    "status-warning-soft": { "$value": "oklch(0.974 0.032 80)" },
    "status-success": { "$value": "oklch(0.508 0.118 165.612)" },
    "status-success-soft": { "$value": "oklch(0.966 0.03 150)" },
    "proof-paper": { "$value": "oklch(0.998 0.002 255)" },
    "proof-ink": { "$value": "oklch(0.225 0.031 255)" },
    "proof-ink-2": { "$value": "oklch(0.43 0.035 255)" },
    "proof-rule": { "$value": "oklch(0.79 0.022 255)" },
    "footer": { "$value": "oklch(0.145 0.025 255)" }
  },
  "color-dark": {
    "$type": "color",
    "$description": "Dark-scheme overrides; all unlisted color tokens remain fixed.",
    "paper": { "$value": "oklch(0.175 0.025 255)" },
    "paper-2": { "$value": "oklch(0.205 0.028 255)" },
    "surface": { "$value": "oklch(0.225 0.028 255)" },
    "surface-strong": { "$value": "oklch(0.27 0.03 255)" },
    "ink": { "$value": "oklch(0.96 0.012 255)" },
    "ink-2": { "$value": "oklch(0.76 0.023 255)" },
    "ink-3": { "$value": "oklch(0.65 0.025 255)" },
    "rule": { "$value": "oklch(0.33 0.033 255)" },
    "rule-strong": { "$value": "oklch(0.45 0.036 255)" },
    "accent-soft": { "$value": "oklch(0.26 0.052 165.612)" },
    "accent-label": { "$value": "{color.accent-night}" },
    "overlay": { "$value": "oklch(0 0 0 / 0.66)" },
    "status-danger": { "$value": "oklch(0.704 0.191 22.216)" },
    "status-danger-soft": { "$value": "oklch(0.26 0.055 27)" },
    "status-warning": { "$value": "oklch(0.795 0.163 86.047)" },
    "status-warning-soft": { "$value": "oklch(0.28 0.05 70)" },
    "status-success": { "$value": "oklch(0.765 0.177 163.223)" },
    "status-success-soft": { "$value": "oklch(0.26 0.045 150)" }
  },
  "font": {
    "$type": "fontFamily",
    "display": { "$value": ["Archivo", "Arial Narrow", "sans-serif"] },
    "body": { "$value": ["Archivo", "system-ui", "sans-serif"] },
    "mono": { "$value": ["JetBrains Mono", "ui-monospace", "monospace"] }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": "0.25rem" },
    "2": { "$value": "0.5rem" },
    "3": { "$value": "0.75rem" },
    "4": { "$value": "1rem" },
    "5": { "$value": "1.5rem" },
    "6": { "$value": "2rem" },
    "7": { "$value": "3rem" },
    "8": { "$value": "4.5rem" },
    "9": { "$value": "7rem" },
    "10": { "$value": "10rem" }
  },
  "text-size": {
    "$type": "dimension",
    "xs": { "$value": "0.75rem" },
    "sm": { "$value": "0.875rem" },
    "md": { "$value": "1rem" },
    "lg": { "$value": "1.25rem" },
    "xl": { "$value": "1.75rem" },
    "display": { "$value": "clamp(2.75rem, 6.4vw, 6.75rem)" }
  },
  "duration": {
    "$type": "duration",
    "fast": { "$value": { "value": 160, "unit": "ms" } },
    "base": { "$value": { "value": 220, "unit": "ms" } },
    "slow": { "$value": { "value": 260, "unit": "ms" } },
    "long": { "$value": { "value": 400, "unit": "ms" } }
  },
  "easing": {
    "$type": "cubicBezier",
    "out": { "$value": [0.16, 1, 0.3, 1] },
    "standard": { "$value": [0.16, 1, 0.3, 1] }
  },
  "rule": {
    "$type": "dimension",
    "thin": { "$value": "1px" }
  },
  "radius": {
    "$type": "dimension",
    "control": { "$value": "0.375rem" },
    "card": { "$value": "0.5rem" },
    "pill": { "$value": "999px" }
  },
  "shadow": {
    "$type": "shadow",
    "popover": {
      "$value": {
        "color": "oklch(0.185 0.027 255 / 0.14)",
        "offsetX": "0rem",
        "offsetY": "0.75rem",
        "blur": "2rem",
        "spread": "0rem"
      }
    },
    "overlay": {
      "$value": {
        "color": "oklch(0.185 0.027 255 / 0.22)",
        "offsetX": "0rem",
        "offsetY": "1.5rem",
        "blur": "4rem",
        "spread": "0rem"
      }
    }
  },
  "size": {
    "$type": "dimension",
    "page-max": { "$value": "88rem" },
    "page-gutter": { "$value": "1rem" },
    "page-gutter-wide": { "$value": "1.5rem" },
    "header": { "$value": "4.5rem" },
    "editor-header": { "$value": "4rem" },
    "editor-rail": { "$value": "4.5rem" },
    "editor-panel": {
      "$value": "20.5rem",
      "$description": "Desktop properties panel below the 80rem widescreen breakpoint"
    },
    "editor-panel-wide": {
      "$value": "24rem",
      "$description": "Properties panel applied at viewport widths of 80rem / 1280px and above"
    },
    "logo": { "$value": "2.5rem" },
    "logo-footer": { "$value": "2.125rem" },
    "logo-wordmark-gap": { "$value": "0.6rem" },
    "dialog": { "$value": "36rem" },
    "dialog-wide": { "$value": "68.75rem" },
    "dialog-viewport-gutter": { "$value": "1.5rem" },
    "dialog-max-block-size": { "$value": "calc(100dvh - 3rem)" },
    "sheet-max-block-size": { "$value": "92dvh" },
    "popover": { "$value": "24rem" },
    "popover-safe-edge": { "$value": "1rem" }
  },
  "z-index": {
    "$type": "number",
    "sticky": { "$value": 30 },
    "sticky-nav": { "$value": 50 },
    "navigation": { "$value": 50 },
    "editor": { "$value": 100 },
    "toast": { "$value": 100 },
    "dialog": { "$value": 200 },
    "popover": { "$value": 900 },
    "system-overlay": { "$value": 1000 },
    "system": { "$value": 1000 }
  },
  "compatibility-alias": {
    "$description": "Legacy editor variable names mapped back to canonical tokens. New code uses the canonical groups above.",
    "brand": { "$type": "color", "$value": "{color.accent-label}" },
    "brand-hover": { "$type": "color", "$value": "{color.accent-hover}" },
    "brand-50": { "$type": "color", "$value": "{color.accent-soft}" },
    "brand-100": {
      "$type": "color",
      "$value": "color-mix(in oklab, var(--color-accent) 14%, var(--color-surface))"
    },
    "brand-200": {
      "$type": "color",
      "$value": "color-mix(in oklab, var(--color-accent) 26%, var(--color-surface))"
    },
    "brand-300": {
      "$type": "color",
      "$value": "color-mix(in oklab, var(--color-accent) 46%, var(--color-surface))"
    },
    "brand-700": { "$type": "color", "$value": "{color.accent-label}" },
    "ink-1": { "$type": "color", "$value": "{color.ink}" },
    "ink-2": { "$type": "color", "$value": "{color.ink-2}" },
    "ink-3": { "$type": "color", "$value": "{color.ink-2}" },
    "ink-4": { "$type": "color", "$value": "{color.ink-3}" },
    "ink-5": {
      "$type": "color",
      "$value": "color-mix(in oklab, var(--color-ink-3) 95%, var(--color-paper))"
    },
    "ink-6": { "$type": "color", "$value": "{color.rule-strong}" },
    "line": { "$type": "color", "$value": "{color.rule}" },
    "line-soft": {
      "$type": "color",
      "$value": "color-mix(in oklab, var(--color-rule) 72%, var(--color-paper))"
    },
    "surface": { "$type": "color", "$value": "{color.surface}" },
    "surface-2": { "$type": "color", "$value": "{color.paper}" },
    "surface-3": { "$type": "color", "$value": "{color.paper-2}" },
    "surface-raised": { "$type": "color", "$value": "{color.surface}" },
    "preview-bg": { "$type": "color", "$value": "{color.paper-2}" },
    "backdrop-bg": { "$type": "color", "$value": "{color.overlay}" },
    "ok": { "$type": "color", "$value": "{color.status-success}" },
    "ok-bg": { "$type": "color", "$value": "{color.status-success-soft}" },
    "ok-border": {
      "$type": "color",
      "$value": "color-mix(in oklab, var(--color-status-success) 42%, var(--color-surface))"
    },
    "warn": { "$type": "color", "$value": "{color.status-warning}" },
    "warn-bg": { "$type": "color", "$value": "{color.status-warning-soft}" },
    "warn-border": {
      "$type": "color",
      "$value": "color-mix(in oklab, var(--color-status-warning) 42%, var(--color-surface))"
    },
    "danger": { "$type": "color", "$value": "{color.status-danger}" },
    "danger-bg": { "$type": "color", "$value": "{color.status-danger-soft}" },
    "danger-border": {
      "$type": "color",
      "$value": "color-mix(in oklab, var(--color-status-danger) 36%, var(--color-surface))"
    },
    "sh-focus": {
      "$type": "shadow",
      "$value": "0 0 0 2px color-mix(in oklab, var(--color-focus) 48%, transparent)"
    },
    "lightness-thumb-bg": { "$type": "color", "$value": "{color.surface}" },
    "lightness-thumb-border": { "$type": "color", "$value": "{color.ink}" }
  }
}
